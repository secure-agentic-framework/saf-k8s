{
  "hostpath_candidate": {
    "apiVersion": "v1",
    "kind": "Pod",
    "metadata": {
      "name": "saf-0304-hostpath-dry-run",
      "namespace": "saf-0304-hostpath-policy"
    },
    "spec": {
      "restartPolicy": "Never",
      "containers": [
        {
          "name": "probe",
          "image": "docker.io/library/busybox:1.37.0@sha256:a7dbc319b1438115a207e11930dc4bb3e643dcb3ec0bdd694bb36cd8fad289ec",
          "command": [
            "sh",
            "-c",
            "sleep 3600"
          ],
          "volumeMounts": [
            {
              "name": "synthetic-host-fixture",
              "mountPath": "/fixture",
              "readOnly": true
            }
          ]
        }
      ],
      "volumes": [
        {
          "name": "synthetic-host-fixture",
          "hostPath": {
            "path": "/tmp/saf-hostpath-fixture",
            "type": "Directory"
          }
        }
      ]
    }
  },
  "permitted_emptydir_candidate": {
    "apiVersion": "v1",
    "kind": "Pod",
    "metadata": {
      "name": "saf-0304-emptydir-dry-run",
      "namespace": "saf-0304-hostpath-policy"
    },
    "spec": {
      "restartPolicy": "Never",
      "containers": [
        {
          "name": "probe",
          "image": "docker.io/library/busybox:1.37.0@sha256:a7dbc319b1438115a207e11930dc4bb3e643dcb3ec0bdd694bb36cd8fad289ec",
          "command": [
            "sh",
            "-c",
            "sleep 3600"
          ],
          "volumeMounts": [
            {
              "name": "synthetic-pod-volume",
              "mountPath": "/fixture"
            }
          ]
        }
      ],
      "volumes": [
        {
          "name": "synthetic-pod-volume",
          "emptyDir": {}
        }
      ]
    }
  },
  "approved_hostpath_candidate": {
    "apiVersion": "v1",
    "kind": "Pod",
    "metadata": {
      "name": "saf-hostpath-approved-collector",
      "annotations": {
        "saf.example/approval-id": "case-record-0304-006-a"
      },
      "namespace": "saf-0304-hostpath-exception"
    },
    "spec": {
      "restartPolicy": "Never",
      "containers": [
        {
          "name": "probe",
          "image": "docker.io/library/busybox:1.37.0@sha256:a7dbc319b1438115a207e11930dc4bb3e643dcb3ec0bdd694bb36cd8fad289ec",
          "command": [
            "sh",
            "-ec",
            "awk '$5 == \"/collector-marker\" && $6 ~ /^ro(,|$)/ { matched=1 } END { exit !matched }' /proc/self/mountinfo; echo readonly-mount-confirmed; cat /collector-marker"
          ],
          "volumeMounts": [
            {
              "name": "synthetic-host-fixture",
              "mountPath": "/collector-marker",
              "readOnly": true
            }
          ],
          "securityContext": {
            "runAsUser": 65534,
            "runAsNonRoot": true,
            "allowPrivilegeEscalation": false,
            "readOnlyRootFilesystem": true,
            "capabilities": {
              "drop": [
                "ALL"
              ]
            },
            "seccompProfile": {
              "type": "RuntimeDefault"
            }
          }
        }
      ],
      "volumes": [
        {
          "name": "synthetic-host-fixture",
          "hostPath": {
            "path": "/var/lib/saf-0304-006-fixture/collector-marker",
            "type": "File"
          }
        }
      ],
      "automountServiceAccountToken": false,
      "terminationGracePeriodSeconds": 1
    }
  }
}
