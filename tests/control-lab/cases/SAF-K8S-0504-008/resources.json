{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "marker-cgi"
      },
      "data": {
        "marker": "#!/bin/sh\nprintf '%s %s %s\\n' \"$HTTP_X_CASE_REQUEST\" \"$REQUEST_METHOD\" \"$REQUEST_URI\" >> /tmp/case-arrivals\nprintf 'Content-Type: text/plain\\r\\n\\r\\n'\nprintf 'case marker\\n'\n",
        "marker-alt": "#!/bin/sh\nprintf '%s %s %s\\n' \"$HTTP_X_CASE_REQUEST\" \"$REQUEST_METHOD\" \"$REQUEST_URI\" >> /tmp/case-arrivals\nprintf 'Content-Type: text/plain\\r\\n\\r\\n'\nprintf 'case marker\\n'\n"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "marker-backend",
        "labels": {
          "app": "marker-backend"
        }
      },
      "spec": {
        "restartPolicy": "Never",
        "containers": [
          {
            "name": "httpd",
            "image": "docker.io/library/busybox:1.37.0@sha256:a7dbc319b1438115a207e11930dc4bb3e643dcb3ec0bdd694bb36cd8fad289ec",
            "command": [
              "httpd",
              "-f",
              "-v",
              "-p",
              "8080",
              "-h",
              "/www"
            ],
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "runAsNonRoot": true,
              "runAsUser": 65534,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "ports": [
              {
                "name": "http",
                "containerPort": 8080
              }
            ],
            "volumeMounts": [
              {
                "name": "cgi",
                "mountPath": "/www/cgi-bin",
                "readOnly": true
              }
            ],
            "readinessProbe": {
              "tcpSocket": {
                "port": 8080
              },
              "periodSeconds": 1
            }
          }
        ],
        "volumes": [
          {
            "name": "cgi",
            "configMap": {
              "name": "marker-cgi",
              "defaultMode": 365,
              "items": [
                {
                  "key": "marker",
                  "path": "marker"
                },
                {
                  "key": "marker-alt",
                  "path": "marker-alt"
                }
              ]
            }
          }
        ],
        "automountServiceAccountToken": false
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "marker-backend"
      },
      "spec": {
        "selector": {
          "app": "marker-backend"
        },
        "ports": [
          {
            "name": "http",
            "port": 8080,
            "targetPort": 8080
          }
        ],
        "type": "ClusterIP"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "marker-client",
        "labels": {
          "app": "marker-client"
        }
      },
      "spec": {
        "restartPolicy": "Never",
        "containers": [
          {
            "name": "client",
            "image": "docker.io/library/python:3.13-slim@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90",
            "command": [
              "python",
              "-c",
              "import time; time.sleep(600)"
            ],
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "runAsNonRoot": true,
              "runAsUser": 65534,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            }
          }
        ],
        "automountServiceAccountToken": false
      }
    }
  ]
}
