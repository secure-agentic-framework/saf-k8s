FROM docker.io/library/python:3.13-slim@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90
ARG TOKENIZER_WHEEL
COPY ${TOKENIZER_WHEEL} /opt/tokenizer/
COPY cl100k_base.tiktoken encoding_fixture.py /opt/tokenizer/
RUN python -m pip install --disable-pip-version-check --no-index --no-deps --no-compile --target /opt/tokenizer/lib "/opt/tokenizer/${TOKENIZER_WHEEL}" && rm "/opt/tokenizer/${TOKENIZER_WHEEL}"
ENV PYTHONPATH=/opt/tokenizer:/opt/tokenizer/lib
